{
  "name": "dsh-read-animation",
  "version": "0.1.0",
  "description": "Let a DeepSeek Harness agent actually see an animated GIF or animated WebP: decode every frame, sample the animation across time, and hand the model a labelled sequence of real frames instead of the single first frame the harness otherwise delivers.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "NeoHotaru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoHotaru/dsh-read-animation.git"
  },
  "homepage": "https://github.com/NeoHotaru/dsh-read-animation#readme",
  "bugs": {
    "url": "https://github.com/NeoHotaru/dsh-read-animation/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-alpha.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "gif",
    "animation",
    "animated-webp",
    "frames",
    "vision",
    "multimodal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/decode.test.js test/envelope.test.js test/filmstrip.test.js test/tool.test.js",
    "test:integration": "node test/integration/harness.mjs",
    "test:all": "npm test && npm run test:integration",
    "fixtures": "python test/fixtures/make-fixtures.py",
    "derive-schema": "node scripts/derive-schema.mjs",
    "preview-sheet": "node scripts/preview-sheet.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-fs": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  }
}
